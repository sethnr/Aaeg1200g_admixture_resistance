container: "docker://sethnr/aaeg1000g_admixture:0.02"
#### Config file and sample sheets #####
configfile: "config/config.yaml"
#### reused methods for grabbing GS objects, etc ####
include: "rules/common.smk"

CHROMS=[1,2,3]
SAMPLES=pd.read_table(config['samples'],dtype=str,header=0)['sample']
AAF_SAMPLES=pd.read_table("config/AAF_samples.txt",dtype=str,header=0)['sample']
AAA_SAMPLES=pd.read_table("config/AAA_samples.txt",dtype=str,header=0)['sample']

LOCI=pd.read_table("config/aaeg_hap_loci.txt",dtype=str,header=0)['locusname']


wildcard_constraints:
    sample="[^\.]+",
    loci="[^\_]+\d?"

ruleorder:
    region_vcf > exon_vcf > sample_vcf > whatshap > merge_whatshap > shapeit > snpeff > tabix_vcf

rule all:
    input:
        #expand("results/locushap_vcf/locus.{locusname}.vcf.gz",
        #    locusname=LOCI)
        #expand("results/locushap_shapeit/snpeff.{locusname}.vcf.gz",
        #    locusname=LOCI)
        expand("results/locushap_plots/{locusname}.m0.haps.png",
            locusname=LOCI)



##### get remotes #######
rule tx_remote_bam:
    input:
        apikey=config["gkey"]
    output:
        bam="results/bams/{sample}.bam",
        bai="results/bams/{sample}.bam.bai"
    resources:
        mem_mb=2000,
        disk_mb=500000,
        #run with, eg, --resources bamspace=10 for 10 sim d/ls
        bamspace=10
    threads: 1,
    params:
        bam=lambda wildcards: get_remote_bam_url(wildcards),
        bai=lambda wildcards: get_remote_bai_url(wildcards),
    container:
        "docker://google/cloud-sdk:latest"
    log:
        "logs/txbam/{sample}.log",
    shell:
        """
        gcloud auth activate-service-account --key-file {input.apikey}
        gsutil cp {params.bam} {output.bam}
        gsutil cp {params.bai} {output.bai}
        #samtools quickcheck {output.bam}
        exit $?
        """


rule tx_remote_vcf:
    input:
        apikey=config["gkey"]
    output:
        vcf="results/vcfs/raw_{chrom}_{block}.vcf.gz"
    resources:
        mem_mb=2000,
        disk_mb=500000,
        #run with, eg, --resources bamspace=10 for 10 sim d/ls
        bamspace=10
    threads: 1,
    params:
        vcf=lambda wildcards: get_remote_vcf_raw_url(wildcards),
    container:
        "docker://google/cloud-sdk:latest"
    log:
        "logs/txvcf/{chrom}_{block}.log",
    shell:
        """
        gcloud auth activate-service-account --key-file {input.apikey}
        gsutil cp {params.vcf} {output.vcf}
        exit $?
        """



##### split and phase vcf #####

rule region_vcf:
    input:
        vcf=lambda wildcards: get_raw_vcf_from_hapname(wildcards),
        tbi=lambda wildcards: get_raw_tbi_from_hapname(wildcards),
        # vcf=lambda wildcards: get_region_vcf_local(wildcards)
        # tbi=lambda wildcards: get_region_vcf_tbi_local(wildcards)
        #vcf="results/vcfs/aegy.wgs.non-AfrI3.mapQ20.GoodSites.dMM3.chr2.comp.bcf.SNP.vcf.gz",
        #tbi="results/vcfs/aegy.wgs.non-AfrI3.mapQ20.GoodSites.dMM3.chr2.comp.bcf.SNP.vcf.gz.tbi",
        loci=ancient(config["haploci"]),
        meta=config["vcfs"],
    output:
        vcf="results/locushap_vcf/locus.{locusname}.vcf.gz",
        tbi="results/locushap_vcf/locus.{locusname}.vcf.gz.tbi"
    resources:
        mem_mb=3000,
    threads: 1,
    log:
        "logs/locushap_locus_vcf/{locusname}.log",
    params:
        #regionstring="NC_035108.1:94761102-95559560"
        regionstring=lambda wildcards: get_region_string(wildcards),
        geneid=lambda wildcards: get_gene_id_from_name(wildcards)
    shell:
        """
        bcftools view -Oz -o {output.vcf} \
                          {input.vcf} {params.regionstring} 2>> {log}
        tabix -p vcf {output.vcf}  2>> {log}
        """


