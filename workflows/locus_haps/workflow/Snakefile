AAA_SAMPLES=pd.read_table("config/AAA_samples.txt",dtype=str,header=0)['sample']

LOCI=pd.read_table("resources/aaeg_hap_loci.txt",dtype=str,header=0)['locusname']


wildcard_constraints:
    samples=SAMPLES,
    #locusname=LOCI

ruleorder:
    subset_vcf > whatshap > whatshap_merge > shapeit #> tabix_vcf

rule all:
