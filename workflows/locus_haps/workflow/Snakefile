##### get remotes #######
rule tx_remote_bam:
    input:
        apikey=config["gkey"]
    output:
        bam="results/bams/{sample}.bam",
        bai="results/bams/{sample}.bam.bai"
    resources:
        mem_mb=2000,
        disk_mb=500000,
        #run with, eg, --resources bamspace=10 for 10 sim d/ls
        bamspace=10
    threads: 1,
    params:
        bam=lambda wildcards: get_remote_bam_url(wildcards),
        bai=lambda wildcards: get_remote_bai_url(wildcards),
    container:
        "docker://google/cloud-sdk:latest"
    log:
        "logs/txbam/{sample}.log",
    shell:
        """
        gcloud auth activate-service-account --key-file {input.apikey}
        gsutil cp {params.bam} {output.bam}
        gsutil cp {params.bai} {output.bai}
        #samtools quickcheck {output.bam}
        exit $?
        """


rule tx_remote_vcf:
    input:
        apikey=config["gkey"]
    output:
        vcf=temporary("results/vcfs/raw_{chrom}_{block}.vcf.gz")
    resources:
        mem_mb=2000,
        disk_mb=500000,
        #run with, eg, --resources bamspace=10 for 10 sim d/ls
        bamspace=10
    threads: 1,
    params:
        vcf=lambda wildcards: get_remote_vcf_raw_url(wildcards),
    container:
        "docker://google/cloud-sdk:latest"
    log:
        "logs/txvcf/{chrom}_{block}.log",
    shell:
        """
        gcloud auth activate-service-account --key-file {input.apikey}
        gsutil cp {params.vcf} {output.vcf}
        exit $?
        """



##### split and phase vcf #####

rule region_vcf:
    input:
        vcf=lambda wildcards: get_raw_vcf_from_hapname(wildcards),
        tbi=lambda wildcards: get_raw_tbi_from_hapname(wildcards),
        # vcf=lambda wildcards: get_region_vcf_local(wildcards)
        # tbi=lambda wildcards: get_region_vcf_tbi_local(wildcards)
        #vcf="results/vcfs/aegy.wgs.non-AfrI3.mapQ20.GoodSites.dMM3.chr2.comp.bcf.SNP.vcf.gz",
        #tbi="results/vcfs/aegy.wgs.non-AfrI3.mapQ20.GoodSites.dMM3.chr2.comp.bcf.SNP.vcf.gz.tbi",
        loci=ancient(config["haploci"]),
        meta=config["vcfs"],

    output:
        outvcf="results/locushap_vcf/split.{locusname}.vcf.gz",
        outtbi="results/locushap_vcf/split.{locusname}.vcf.gz.tbi"
    resources:
        mem_mb=3000,
    threads: 1,
    log:
        "logs/locushap_split_vcf/{locusname}.log",
    params:
        #regionstring="NC_035108.1:94761102-95559560"
        regionstring=lambda wildcards: get_region_string(wildcards),
        geneid=lambda wildcards: get_gene_id_from_name(wildcards)
    shell:
        """
        bcftools view -Oz  \
                -o results/locushap_vcf/split.{wildcards.locusname}.vcf.gz \
                          {input.vcf} {params.regionstring} 2>> {log}
        tabix -p vcf results/locushap_vcf/split.{wildcards.locusname}.vcf.gz  2>> {log}
        """


rule thinvcf:
    input:
        vcf="results/locushap_vcf/split.{locusname}.vcf.gz",
        tbi="results/locushap_vcf/split.{locusname}.vcf.gz.tbi"
    output:
        vcf=temporary("results/locushap_vcfthin.{locusname}.vcf.gz"),
        tbi=temporary("results/locushap_vcf/thin.{locusname}.vcf.gz.tbi")
    resources:
        mem_mb=4000,
        h_rt='1:00:00'
    threads: 1,
    log:
        "logs/locushap_vcf/thin.{locusname}.log",
    shell:
        """
          bcftools view -c 1 -O z -o {output.vcf}  {input.vcf} 2>> {log}
          tabix -pvcf {output.vcf} 2>> {log}
        """



rule exon_vcf:
    input:
        vcf="results/locushap_vcf/thin.{locusname}.vcf.gz",
        tbi="results/locushap_vcf/thin.{locusname}.vcf.gz.tbi",
        loci=ancient(config["haploci"]),
        gff=ancient(config["features"]),
    output:
        bed="results/locushap_vcf/exons.{locusname}.bed",
        vcf="results/locushap_vcf/exons.{locusname}.vcf.gz",
        tbi="results/locushap_vcf/exons.{locusname}.vcf.gz.tbi"
    resources:
        mem_mb=3000,
    threads: 1,
    log:
        "logs/locushap_vcf/{locusname}.log",
    params:
        geneid=lambda wildcards: get_gene_id_from_name(wildcards)
    shell:
        """
        python scripts/get_gene_merged_exons.py \
            -o results/{wildcards.stage}/exons.{wildcards.locusname}.bed \
            -n {params.geneid} \
            -g {input.gff}

        bcftools view -Oz  -R results/{wildcards.stage}/exons.{wildcards.locusname}.bed \
                        -o results/{wildcards.stage}/exons.{wildcards.locusname}.vcf.gz \
                          {input.vcf} 2>> {log}
        tabix -p vcf results/{wildcards.stage}/exons.{wildcards.locusname}.vcf.gz  2>> {log}
        """


rule sample_vcf:
    input:
        vcf="results/locushap_vcf/exons.{locusname}.vcf.gz",
        tbi="results/locushap_vcf/exons.{locusname}.vcf.gz.tbi"
    output:
        outvcf=temporary("results/locushap_split_vcf/exons.{locusname}.{sample}.vcf.gz"),
        outtbi=temporary("results/locushap_split_vcf/exons.{locusname}.{sample}.vcf.gz.tbi")
        #outvcf="results/locushap_split_vcf/split.{locusname}.{sample}.vcf.gz",
        #outtbi="results/locushap_split_vcf/split.{locusname}.{sample}.vcf.gz.tbi"
    resources:
        mem_mb=3000,
    threads: 1,
    log:
        "logs/locushap_split_vcf/{locusname}.{sample}.log",
    shell:
        """
        bcftools view -Oz -s {wildcards.sample} \
                          -o results/locushap_split_vcf/split.{wildcards.locusname}.{wildcards.sample}.vcf.gz \
                          {input.vcf} 2>> {log}
        tabix -p vcf results/locushap_split_vcf/split.{wildcards.locusname}.{wildcards.sample}.vcf.gz  2>> {log}
        """


rule whatshap:
    input:
        vcf="results/locushap_split_vcf/exons.{locusname}.{sample}.vcf.gz",
        bam="results/bams/{sample}.bam",
        bai="results/bams/{sample}.bam.bai",
        ref=config['fasta'],
        fai=config['fai']
    output:
        vcf=temporary("results/locushap_whatshap/whatshap.{locusname}.{sample}.vcf.gz"),
        tbi=temporary("results/locushap_whatshap/whatshap.{locusname}.{sample}.vcf.gz.tbi")
        #vcf="results/locushap_whatshap/whatshap.{locusname}.{sample}.vcf.gz",
        #tbi="results/locushap_whatshap/whatshap.{locusname}.{sample}.vcf.gz.tbi"
    resources:
        mem_mb=4000,
        h_rt='1:00:00'
    threads: 1,
    log:
        "logs/locushap_whatshap/{locusname}.{sample}.log",
    shell:
        """
          whatshap phase {input.vcf} {input.bam} -r {input.ref} -o {output.vcf} 2>> {log}
          tabix -pvcf {output.vcf} 2>> {log}
        """

rule whatshap_merge:
    input:
        vcfs=expand("results/locushap_whatshap/whatshap.{{locusname}}.{sample}.vcf.gz",
            sample=SAMPLES),
        tbis=expand("results/locushap_whatshap/whatshap.{{locusname}}.{sample}.vcf.gz.tbi",
            sample=SAMPLES)
    output:
        filelist="results/locushap_whatshap/filelist.{locusname}.txt",
        vcf=protected("results/locushap_whatshap/whatshap.{locusname}.vcf.gz"),
        tbi=protected("results/locushap_whatshap/whatshap.{locusname}.vcf.gz.tbi"),
    resources:
        bamspace=0,
        h_rt='6:00:00',
        mem_mb=16000,
        disk_mb=100000,
        cpus=4
    threads:4
    log:
        "logs/phase_whatshap/merge.{locusname}.log",
    shell:
        """
	       echo {input.vcfs} | tr ' ' '\n' > {output.filelist}
	       bcftools merge --threads {threads} -o {output.vcf} -O z -l {output.filelist};  2>> {log}
           tabix -pvcf {output.vcf} 2>> {log}
	"""


rule shapeit:
    input:
        vcf="results/locushap_whatshap/whatshap.{locusname}.vcf.gz",
        tbi="results/locushap_whatshap/whatshap.{locusname}.vcf.gz.tbi",
#        map=config['map']
    output:
        vcf=protected("results/locushap_shapeit/shapeit.{locusname}.vcf.gz"),
    resources:
        mem_mb=16000,
        disk_mb=10000,
        h_rt='96:00:00',
        bamspace=0,
        cpus=8,
	qsub_args='-l highmem  -l avx2=TRUE -l node_type=srm'
    threads: 8
    params:
        #regionstring="NC_035108.1:94761102-95559560"
        regionstring=lambda wildcards: get_region_string(wildcards)
    log:
        "logs/locushap_shapeit/phased.{locusname}.log",
    shell:
        """
        shapeit4 --input {input.vcf} \
                 --region {params.regionstring} \
                 --thread {threads} --log {log} \
                 --output {output.vcf} \
		         --sequencing
        """


rule snpeff:
    input:
        vcf="results/locushap_shapeit/shapeit.{locusname}.vcf.gz",
        tbi="results/locushap_shapeit/shapeit.{locusname}.vcf.gz.tbi",
#        map=config['map']
    output:
        vcf=protected("results/locushap_shapeit/snpeff.{locusname}.vcf.gz"),
    log:
        "logs/locushap_shapeit/snpeff.{locusname}.log",
    container:
        "docker://sethnr/aaeg1000g_hapnet:0.01"
    shell:
        """
        gunzip -dc {input.vcf} | \
        snpEff eff  -no-downstream -no-upstream -no-intergenic -no-intron -no-utr \
                    -canon -dataDir {snpeffdir} AaegL5 | \
        bcftools view -o {output.vcf} -O z 2> {log}

        tabix -p vcf {output.vcf}
        """
