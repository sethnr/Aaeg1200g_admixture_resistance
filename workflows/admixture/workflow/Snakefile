container: "docker://sethnr/aaeg1000g_admixture:0.02"
#### Config file and sample sheets #####
configfile: "config/config.yaml"
#### reused methods for grabbing GS objects, etc ####
include: "rules/common.smk"

CHROMS=[1,2,3]
SAMPLES=pd.read_table(config['samples'],dtype=str,header=0)['sample']

wildcard_constraints:
    chrom=CHROMS

rule all:
    input:
        expand("results/admix_3pop/3pop_{chrom}_{pop}.out",chrom=CHROMS,pop=POPS)

###rule orders ###
#ruleorder: whatshap_sample > tabix_vcf


##### run admix tests on 4 pops #####


rule fs_3pop:
    input:
        vcf="results/phase_shapeit/phased_shapeit_{chrom}.vcf.gz",
        tbi="results/phase_shapeit/phased_shapeit_{chrom}.vcf.gz.tbi",
    output:
        blk="results/admix_tests/3pop_{pop1}_{pop2}_{pop3}_blocks.txt"
        sum="results/admix_tests/3pop_{pop1}_{pop2}_{pop3}_summary.txt"
    resources:
        mem_mb=4000,
        disk_mb=20000,
        h_rt='2:00:00',
    params:
        chromid=lambda wildcards: get_chrom_id(wildcards)
        prefix="results/admix_tests/3pop_{pop1}_{pop2}_{pop3}_blocks"
    log:
        "logs/admix_3pop/3pop-chr{chrom}_{pop1}_{pop2}_{pop3}.log",
    shell:
        """
	    python scripts/run_3pop_tests.py \
            -p1 {wildcards.pop1} -p2 {wildcards.pop2} -p3 {wildcards.pop3} \
            -m {input.meta} -M 'country' \
            -c {wildcards.chrom} -v {input.vcf} \
            -o {params.prefix}
        """
