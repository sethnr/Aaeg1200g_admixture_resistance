SAMPLES=pd.read_table(config['samples'],dtype=str,header=0)['sample']

wildcard_constraints:
    chrom=CHROMS

rule all:
    input:
       expand("results/phase_shapeit/phased_shapeit_{chrom}.vcf.gz",
       chrom=[1])
