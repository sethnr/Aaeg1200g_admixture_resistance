rule merge_aaa_vcfs:
    input:
        vcfs=expand("results/phase_whatshap/whatshapp_{{chrom}}_{sample}.vcf.gz",
            sample=AAA_SAMPLES),
        tbis=expand("results/phase_whatshap/whatshapp_{{chrom}}_{sample}.vcf.gz.tbi",
            sample=AAA_SAMPLES),
    output:
        vcf=protected("results/phase_whatshap/whatshap_{chrom}_AAAsamples.vcf.gz"),
    resources:
        bamspace=0,
        h_rt='6:00:00',
        mem_mb=8000,
        disk_mb=50000,
        cpus=4
    threads:4
        shell:
            """
    	       echo {input.vcfs} | tr ' ' '\n' > {output.filelist}
    	       bcftools merge --threads {threads} -o {output.vcf} -O z -l {output.filelist};
    	    """

rule merge_aaf_vcfs:
    input:
        vcfs=expand("results/phase_whatshap/whatshapp_{{chrom}}_{sample}.vcf.gz",
            sample=AAF_SAMPLES),
        tbis=expand("results/phase_whatshap/whatshapp_{{chrom}}_{sample}.vcf.gz.tbi",
            sample=AAF_SAMPLES),
    output:
        vcf=protected("results/phase_whatshap/whatshap_{chrom}_AAAsamples.vcf.gz"),
    resources:
        bamspace=0,
        h_rt='6:00:00',
        mem_mb=8000,
        disk_mb=50000,
        cpus=4
    threads:4
        shell:
            """
    	       echo {input.vcfs} | tr ' ' '\n' > {output.filelist}
    	       bcftools merge --threads {threads} -o {output.vcf} -O z -l {output.filelist};
    	    """

rule merge_aaa_aaf:
    input:
        aaa="results/phase_whatshap/whatshap_{chrom}_AAAsamples.vcf.gz"
        aaatbi="results/phase_whatshap/whatshap_{chrom}_AAFsamples.vcf.gz.tbi"
        aaf="results/phase_whatshap/whatshap_{chrom}_AAAsamples.vcf.gz"
        aaftbi="results/phase_whatshap/whatshap_{chrom}_AAFsamples.vcf.gz.tbi"
    output:
        vcf=protected("results/phase_whatshap/whatshap_{chrom}.vcf.gz"),
    resources:
        bamspace=0,
        h_rt='6:00:00',
        mem_mb=16000,
        disk_mb=100000,
        cpus=4
    threads:4
    log:
        "logs/phase_whatshap/merge-chr{chrom}.log",
    shell:
        """
	       bcftools merge --threads {threads} -o {output.vcf} -O z {input.aaa} {input.aaf};
	    """


rule phase_shapeit:
    input:
        vcf="results/phase_whatshap/whatshap_{chrom}.vcf.gz",
        tbi="results/phase_whatshap/whatshap_{chrom}.vcf.gz.tbi",
        map=config['map']
    output:
        vcf=protected("results/phase_shapeit/phased_shapeit_{chrom}.vcf.gz"),
    resources:
        mem_mb=16000,
        disk_mb=500000,
        h_rt='24:00:00',
        bamspace=0,
        cpus=4
    threads: 4
    params:
        chromid=lambda wildcards: get_chrom_id(wildcards)
    log:
        "logs/phase_shapeit/merge-chr{chrom}.log",
    shell:
        """
        shapeit4 --input {input.vcf} --map {input.map} \
                 --region {params.chromid} \
                 --thread {threads} --log {log} \
                 --output {output.vcf}
        """
