from snakemake.remote.GS import RemoteProvider as GSRemoteProvider
GS = GSRemoteProvider()


container: "docker://sethnr/aaeg1000g_analysis:0.03"
#### Config file and sample sheets #####
configfile: "config/config.yaml"
#### reused methods for grabbing GS objects, etc ####
include: "rules/common.smk"


spps = ["aaa", "aaf"]
#bigcountries = ["Brazil", "USA", "Senegal",
#     "Kenya", "Philippines","Gabon","Ghana",
#     "SaudiArabia","BurkinaFaso","PuertoRico",
#     "Uganda","Trinidad","Vietnam"]

bigcountries = ["Brazil", "USA", "Senegal",
     "Philippines","Gabon","Ghana",
     "SaudiArabia","BurkinaFaso","PuertoRico",
     "Uganda","Trinidad","Vietnam"]
REGIONS=bigcountries

conts = ["eafrica", "wafrica"]


wildcard_constraints:
    block="\d+",
    chrom="\d+",
    #spp="aaa|aaf|admx",
    #cont="americas|asia|wafrica|eafrica",
    #location="aaa|aaf|admx|americas|asia|wafrica|eafrica"
    spp="|".join(spps),
    cont="|".join(conts),
    region="|".join(conts+spps+bigcountries),


rule all:
    input:
        #expand("results/lostruct_plot/invs_chr{chrid}_{loc}_aims.png",
        #chrid=[1,2,3],loc=bigcountries),
        expand("results/lostruct_merge/invs_chr{chrid}_inv_calls.txt",
        chrid=[1,2,3])

###### run lostruct algorithm ########
# blocks of PCAs for each 0.5mb, then a distance matrix
# of first two PCS for each to find similar regions
rule lostruct_get_distances:
    input:
        vcf=lambda wildcards: get_remote_vcf(wildcards),
        tbi=lambda wildcards: get_remote_vcf_tbi(wildcards),
        spptable=config["spptable"],
    output:
        pcs="results/lostruct_run/lostruct_chr{chrom}_{region}.txt",
    params:
        png="results/lostruct_run/lostruct_chr{chrom}_{region}.png",
    resources:
        mem_mb=12000,
        disk_mb=500000,
    threads: 3
    log:
        log="logs/lostruct_run/outliers_chr{chrom}_{region}.log",
    shell:
        """Rscript --vanilla scripts/lostruct_get_pc_distances.R \
              {input.vcf} \
              {input.spptable}  \
              {wildcards.chrom} {wildcards.region} \
              {output.pcs} \
              {params.png}\
              2> {log}
        """

# using PC distances, find distinct regions that might be inversions
# output list of candidates and image of regions
rule find_inversion_candidates:
    input:
        dists=ancient("results/lostruct_run/lostruct_chr{chrom}_{region}.txt")
    output:
        txt="results/lostruct_inversion_candidates/regions_chr{chrom}_{region}.txt",
        png="results/lostruct_inversion_candidates/regions_chr{chrom}_{region}.png",
    resources:
        mem_mb=12000,
        disk_mb=500000,
        h_rt='48:00:00',
        cpus=4
    params:
        prefix="results/lostruct_inversion_candidates/regions_chr{chrom}_{region}"
    threads: 4
    log:
        log="logs/lostruct_inversion_candidates/regions-chr{chrom}_{region}.log",
    shell:
        """Rscript scripts/find_inversion_candidates.R \
        	-i {input.dists} \
        	-o {params.prefix} \
        	-c {wildcards.chrom} \
        	-C {threads} \
        	2>> {log}
        """

rule assess_inversion_candidates:
    input:
        vcf=lambda wildcards: get_remote_vcf(wildcards),
        tbi=lambda wildcards: get_remote_vcf_tbi(wildcards),
        #vcf="verily-aaeg1200g/vcfs/SNPs/pruned_sites/aegy.wgs.aaa.aaf.mapQ20.GoodSites.chr{chrom}.SNP.refseq.7e6.vcf.gz",
        #tbi="verily-aaeg1200g/vcfs/SNPs/pruned_sites/aegy.wgs.aaa.aaf.mapQ20.GoodSites.chr{chrom}.SNP.refseq.7e6.vcf.gz.tbi",
        txt=ancient("results/lostruct_inversion_candidates/regions_chr{chrom}_{region}.txt"),
        spptable=config["spptable"],
    output:
        txt="results/lostruct_inversions/assess_chr{chrom}_{region}.txt",
        calls="results/lostruct_inversions/assess_chr{chrom}_{region}_calls.txt",
        png="results/lostruct_plot/assess_chr{chrom}_{region}.png",
    resources:
        mem_mb=12000,
        disk_mb=500000,
        h_rt='1:00:00',
        cpus=1
    params:
        prefix="results/lostruct_inversions/assess_chr{chrom}_{region}",
        MAXD=0.1,
        MAXWSS=5,
        MINBSS=25,
        MINBSP=0.95
    threads: 1
    log:
        log="logs/lostruct_inversions/inversions-chr{chrom}_{region}.log",
    shell:
        """Rscript scripts/assess_inversion_candidates.R \
        	-i {input.txt} \
        	-o {params.prefix} \
            -v {input.vcf} \
            -s {input.spptable} \
            -c {wildcards.region} \
            -D {params.MAXD} \
        	-W {params.MAXWSS} \
        	-B {params.MINBSS} \
        	-P {params.MINBSP} #\
        	# 2>> {log}

        mv {params.prefix}.png {output.png}
        """

#merge inversions within sample / pop by position
rule merge_invs_sample:
    input:
        blocks="results/lostruct_inversion_candidates/regions_chr{chrom}_{region}.txt",
        calls="results/lostruct_inversions/assess_chr{chrom}_{region}_calls.txt",
        meta=config["spptable"]
    output:
        calls="results/lostruct_inversions/invs_chr{chrom}_{region}_calls.txt",
        merges="results/lostruct_inversions/invs_chr{chrom}_{region}_merges.txt",
        blocks="results/lostruct_inversions/invs_chr{chrom}_{region}_blocks.txt",
  	#aimspic="results/lostruct_merge/aims_chr{chrom}_{region}.png",
    params:
        prefix="results/lostruct_inversions/invs_chr{chrom}_{region}",
    resources:
        mem_mb=1000,
        disk_mb=2000,
    log:
        log="logs/lostruct_merge/merge_chr{chrom}_{region}.log",
    shell:
        """
        Rscript scripts/merge_inversions_by_position.R \
          -b {input.blocks} \
          -i {input.calls} \
          -r {wildcards.region} \
          -c {wildcards.chrom} \
          -o {params.prefix} 2> {log}
        """


# using PC calls for regions thought to be inversions
# get associated SNPs that could be used as AIMs for
# these haplotypes
rule get_aims:
      input:
          vcf=lambda wildcards: get_remote_vcf(wildcards),
          tbi=lambda wildcards: get_remote_vcf_tbi(wildcards),
          blocks="results/lostruct_inversions/invs_chr{chrom}_{region}_blocks.txt",
          calls="results/lostruct_inversions/invs_chr{chrom}_{region}_calls.txt",
          spptable=config["spptable"]
      output:
          txt="results/lostruct_inversions/invs_chr{chrom}_{region}_aims.txt",
      resources:
          mem_mb=4000,
          disk_mb=100000,
	  h_rt='2:00:00',
      log:
          log="logs/lostruct_merge/get_aims_chr{chrom}_{region}.log",
      shell:
          """Rscript scripts/find_inversion_aims.R \
                -b {input.blocks} \
                -c {input.calls} \
                -v {input.vcf} \
        		-P 1e-07 \
        		-X 100 \
                -N 20 \
                -o {output.txt}\
            2> {log}
          """


rule make_inversion_plots:
      input:
          aims="results/lostruct_merge/invs_chr{chrom}_{region}_aims.txt",
          invs="results/lostruct_merge/invs_chr{chrom}_{region}_blocks.txt",
          dists=ancient("results/lostruct_run/lostruct_chr{chrom}_{region}.txt"),
          meta=config["spptable"]
      output:
          aimspic="results/lostruct_plot/invs_chr{chrom}_{region}_aims.png",
      resources:
          mem_mb=4000,
          disk_mb=10000,
      params:
          prefix="results/lostruct_plot/invs_chr{chrom}_{region}",
      log:
          log="logs/lostruct_plots/plot_chr{chrom}_{region}.log",
      shell:
        """
        Rscript scripts/make_inversion_plots.R \
          -i {input.invs} \
          -a {input.aims} \
          -m {input.meta} \
          -d {input.dists} \
          -o {params.prefix}
        """


#merge inversions within sample / pop by position
rule merge_invs_global:
    input:
        invs=expand("results/lostruct_inversions/invs_chr{{chrom}}_{region}_blocks.txt",region=REGIONS),
        aims=expand("results/lostruct_inversions/invs_chr{{chrom}}_{region}_aims.txt",region=REGIONS),
        vcf=lambda wildcards: get_remote_vcf(wildcards),
        tbi=lambda wildcards: get_remote_vcf_tbi(wildcards),
        meta=config["spptable"]
    output:
        aims="results/lostruct_merge/invs_chr{chrom}_aims.txt",
    params:
        indir="results/lostruct_inversions/",
        prefix="results/lostruct_merge/invs_chr{chrom}",
        minr2=0.25
    resources:
        mem_mb=32000,
        disk_mb=20000,
    log:
        "logs/lostruct_merge/invs_chr{chrom}_LDmerge.log",
    shell:
        """
        Rscript scripts/merge_inversions_by_linkage.R \
          -d {params.indir} \
          -r {params.minr2} \
	      -v {input.vcf} \
	      -m {input.meta} \
          -c {wildcards.chrom} \
          -o {params.prefix} > {log}

        """

#call inversions using merged aims
rule call_plot_global:
    input:
        aims="results/lostruct_merge/invs_chr{chrom}_aims.txt",
        aims="results/lostruct_merge/invs_chr{chrom}_blocks.txt",
        vcf=lambda wildcards: get_remote_vcf(wildcards),
        tbi=lambda wildcards: get_remote_vcf_tbi(wildcards),
        meta=config["spptable"]
    output:
        calls="results/lostruct_merge/invs_chr{chrom}_inv_calls.txt",
        png="results/lostruct_merge/invs_chr{chrom}_aims.png"
    params:
        prefix="results/lostruct_merge/invs_chr{chrom}",
    resources:
        mem_mb=8000,
        disk_mb=10000,
    log:
        "logs/lostruct_merge/invs_chr{chrom}_call.log",
    shell:
        """
        Rscript scripts/plot_cluster_aims.R \
            -s {input.meta} \
            -i {params.prefix}_aims.txt \
            -b {params.prefix}_blocks.txt \
            -o {output.png} > {log}

        Rscript scripts/call_inversions_mean.R \
          -i {input.aims} \
          -m {input.meta} \
          -o {params.prefix} >> {log}
        """




