from snakemake.remote.GS import RemoteProvider as GSRemoteProvider
GS = GSRemoteProvider()


#configfile: "config_lostruct/config.yaml"
include: "rules/common.smk"


#spps = ["aaa", "aaf", "admx"]
spps = ["aaa", "aaf"]
conts = ["americas", "asia", "eafrica", "wafrica"]
#conts = ["eafrica", "wafrica"]

wildcard_constraints:
    block="\d+",
    chrom="\d+",
    #spp="aaa|aaf|admx",
    #cont="americas|asia|wafrica|eafrica",
    #location="aaa|aaf|admx|americas|asia|wafrica|eafrica"
    spp="|".join(spps),
    cont="|".join(conts),
    location="|".join(conts+spps),


rule all:
    input:
        expand("results_lostruct/lostruct_all_chr/lostruct_chr{chrid}_{loc}.png",
        chrid=[1,2,3],loc=conts),
        #expand("results_lostruct/lostruct_dists/lostruct_chr{chrid}_{loc}_pca_composite.png",
        #        chrid=[1,2,3],loc=conts),



##### Modules #####


rule thin_variants:
    input:
        vcftable=config["vcfs"],
        vcf=lambda wildcards: get_remote_vcf(wildcards),
        #vcf=get_remote_vcf({wildcards.chrom},{block}),
        regions=GS.remote(config["good_regions"]),
    output:
        outvcf=protected("results_lostruct/good_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz"),
    resources:
        mem_mb=3000,
        disk_mb=500000,
    threads: 1,
    log:
        "logs/thin_variants/{chrom}.{block}.log",
    shell:
        """
          bcftools index -t {input.vcf} 2> {log};

          bcftools view --threads 1 \
          -c 10:major -c 10:nref \
          -R {input.regions} \
          -o {output.outvcf} -O z \
          {input.vcf} 2> {log}
        """

rule thin_variants_noreps:
    input:
        vcftable=config["vcfs"],
        vcf=lambda wildcards: get_remote_vcf(wildcards),
        #vcf=get_remote_vcf({wildcards.chrom},{block}),
        regions=GS.remote(config["norep_regions"]),
    output:
        outvcf=protected("results_lostruct/norep_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz"),
    resources:
        mem_mb=3000,
        disk_mb=500000,
    threads: 1,
    log:
        "logs/thin_variants_norep/{chrom}.{block}.log",
    shell:
        """
          bcftools index -t {input.vcf} 2> {log};

          bcftools view --threads 1 \
          -c 10:major -c 10:nref \
          -R {input.regions} \
          -o {output.outvcf} -O z \
          {input.vcf} 2> {log}
        """

rule thin_variants_random:
    input:
        thin="results_lostruct/norep_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz",
    output:
        outvcf=temporary("results_lostruct/norep_regions_thinrand/chr{chrom}_blk{block}_thin.vcf.gz"),
    log:
        "logs/thin_variants_random/chr{chrom}_blk{block}.log",
    shell:
        """gunzip -dc {input.thin} | \
           perl -ne 'print $_ if m/^\#/gi or rand() < 0.1' | \
           bgzip > {output.outvcf}  2> {log}
        """

rule concat_vcfs:
    input:
        vcftable=config["vcfs"],
        vcfs=lambda wildcards: expand("results_lostruct/norep_regions_thinrand/{blockstring}_thin.vcf.gz",
                                              blockstring=get_chrom_blocks_string(wildcards)),
        tbis=lambda wildcards: expand("results_lostruct/norep_regions_thinrand/{blockstring}_thin.vcf.gz.tbi",
                                              blockstring=get_chrom_blocks_string(wildcards))
    output:
        "results_lostruct/norep_regions_thinrand/lostruct_chr{chrom}.vcf.gz",
    log:
        "logs/thin_variants_random/merge-chr{chrom}.log",
    shell:
        """
        bcftools --version 2>> {log}
        bcftools concat -o temp_{wildcards.chrom}.bcf -O u {input.vcfs} 2>> {log};

        bcftools sort -o {output} -O z temp_{wildcards.chrom}.bcf 2>> {log}
        """

rule lostruct_all_chr:
    input:
        vcf="results_lostruct/norep_regions_thinrand/lostruct_chr{chrom}.vcf.gz",
        tbi="results_lostruct/norep_regions_thinrand/lostruct_chr{chrom}.vcf.gz.tbi",
        spptable=config["spptable"],

    output:
        pcs="results_lostruct/lostruct_all_chr/lostruct_chr{chrom}_{cont}.txt",
        png="results_lostruct/lostruct_all_chr/lostruct_chr{chrom}_{cont}.png",
    resources:
        mem_mb=12000,
        disk_mb=500000,
    threads: 3
    log:
        log="logs/lostruct_dists/dist-chr{chrom}_{cont}.log",
    shell:
        """Rscript --vanilla scripts/lostruct_thinvars_region.R \
              {input.vcf} {wildcards.chrom} {input.spptable} \
              {wildcards.cont} {output.pcs} {output.png}\
              2> {log}
        """




rule lostruct_block:
    input:
        pcblock="results_lostruct/norep_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz",
        pcblocktbi="results_lostruct/norep_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz.tbi",
    output:
        lsblock=temporary("results_lostruct/lostruct_pcs/lostruct_pcs_chr{chrom}_blk{block}.txt"),
        #lsblockposn=temporary("results_lostruct/lostruct/lostruct_pcs_chr{chrom}_blk{block}.pos.txt"),
    log:
        "logs/lostruct/chr{chrom}_blk{block}.log",
    shell:
        """Rscript --vanilla scripts/lostruct_pcs_block.R \
              {input.pcblock} {wildcards.chrom} {wildcards.block} {output.lsblock} \
              2> {log}
        """



rule lostruct_merge_sort:
    input:
        vcftable=config["vcfs"],
        pcblocks=lambda wildcards: expand("results_lostruct/lostruct_pcs/lostruct_pcs_{blockstring}.txt",
                                          blockstring=get_chrom_blocks_string(wildcards))
    output:
        "results_lostruct/lostruct_pcs/lostruct_chr{chrom}_pcs.txt",
    log:
        "logs/lostruct_merge/merge-chr{chrom}.log",
    shell:
        """cat {input.pcblocks} | sort -u -k1,1df -k2,3g > {output}
        """

rule lostruct_distance:
    input:
        chromblock="results_lostruct/lostruct_pcs/lostruct_chr{chrom}_pcs.txt",
    output:
        pcs="results_lostruct/lostruct_dists/lostruct_chr{chrom}_dists.txt",
        png="results_lostruct/lostruct_dists/lostruct_chr{chrom}_dists.png",
    resources:
        mem_mb=12000,
        disk_mb=500000,
    threads: 3
    log:
        log="logs/lostruct_dists/dist-chr{chrom}.log",
    shell:
        """Rscript --vanilla scripts/lostruct_calc_distance.R \
              {input.chromblock} {output.pcs} {output.png} \
              2> {log}
        """

rule lostruct_composite:
    input:
        pcs="results_lostruct/lostruct_pcs/lostruct_chr{chrom}_pcs_{cont}.txt",
        dists="results_lostruct/lostruct_dists/lostruct_chr{chrom}_dists_{cont}.txt",
        invs=config["invtable"],
    output:
        overlay="results_lostruct/lostruct_dists/lostruct_chr{chrom}_{cont}_invs_overlay.png",
        comp="results_lostruct/lostruct_dists/lostruct_chr{chrom}_{cont}_pca_composite.png",
    resources:
        mem_mb=8000,
        disk_mb=300000,
    log:
        log="logs/lostruct_dists/dist-chr{chrom}_{cont}_composite.log",
    shell:
        """Rscript scripts/lostruct_dists_invs_overlay.R \
        {input.dists} {input.pcs} {input.invs} \
        {wildcards.chrom} {wildcards.cont} {output.overlay} {output.comp} \
        2> {log}
        """


