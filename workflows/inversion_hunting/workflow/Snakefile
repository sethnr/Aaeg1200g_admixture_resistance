rule lostruct_block_spp:
    input:
        spptable=config["spptable"],
        pcblock="results_lostruct/norep_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz",
        pcblocktbi="results_lostruct/norep_regions/chr{chrom}.10MB.blk.{block}_thin.vcf.gz.tbi",
    output:
        lsblock=temporary("results_lostruct/lostruct_pcs/lostruct_pcs_chr{chrom}_blk{block}_{spp}.txt"),
        #lsblockposn=temporary("results_lostruct/lostruct/lostruct_pcs_chr{chrom}_blk{block}.pos.txt"),
    log:
        "logs/lostruct/chr{chrom}_blk{block}_{spp}.log",
    shell:
        """Rscript --vanilla scripts/lostruct_pcs_block_spp.R \
              {input.pcblock} {wildcards.chrom} {wildcards.block} \
              {input.spptable} {wildcards.spp} \
              {output.lsblock} \
              2> {log}
        """

rule lostruct_merge_sort_spp:
    input:
        vcftable=config["vcfs"],
        pcblocks=lambda wildcards: expand("results_lostruct/lostruct_pcs/lostruct_pcs_{blockstring}_{{spp}}.txt",
                                          blockstring=get_chrom_blocks_string(wildcards))
    output:
        "results_lostruct/lostruct_pcs/lostruct_chr{chrom}_pcs_{spp}.txt",
    log:
        "logs/lostruct_merge/merge-chr{chrom}_{spp}.log",
    shell:
        """cat {input.pcblocks} | sort -u -k1,1df -k2,3g > {output}
        """

rule lostruct_distance_spp:
